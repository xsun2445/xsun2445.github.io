---
layout: default
---
<div id="about" class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title | regex_replace: '([一-鿿]+)', '<span style="color: var(--global-text-color-light)">\1</span>' }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% assign profile_image_alt = page.profile.image_alt | default: page.title %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile_image_alt
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
        {%- comment -%}  {%- endcomment -%}
        <div class="social">
          <div class="contact-icons">{% include social.liquid %}</div>
        </div>
        {%- comment -%}  {%- endcomment -%}
      </div>
    {% endif %}

    <div class="clearfix profile-intro">{{ content }}</div>

    <!-- News -->
    {% if page.news and site.announcements and site.announcements.enabled %}
      <section id="news" class="profile-section">
        <h2 class="profile-section__title">News</h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {%- comment -%} Talks {%- endcomment -%}
    <section id="talks" class="profile-section">
      <h2 class="profile-section__title">Talks</h2>
      {% include talks.liquid %}
    </section>

    <!-- Latest posts -->
    {% if site.latest_posts and site.latest_posts.enabled %}
      <section id="latest-posts" class="profile-section">
        <h2 class="profile-section__title">
          <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest posts</a>
        </h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section id="publications" class="profile-section">
        <h2 class="profile-section__title">Publications</h2>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}

    {%- comment -%} Awards {%- endcomment -%}
    <section id="awards" class="profile-section">
      <h2 class="profile-section__title">Awards</h2>
      <ul class="profile-list">
        <li class="profile-list__item">ACM MobiSys Rising Star <span class="profile-meta">(2026)</span></li>
        <li class="profile-list__item">UW ECE Research Showcase Best Demo Award sponsored by Apple <span class="profile-meta">(2025)</span></li>
        <li class="profile-list__item">
          <a href="https://www.t-mobile.com/news/network/2024-t-challenge-winners">
            T-Mobile T-Challenge — AI for Telecommunications Finalist & Most Engaging Presentation Award
          </a>
          <span class="profile-meta">(2024)</span>
        </li>
        <li class="profile-list__item">
          <a href="https://sensys.acm.org/2022/award/">ACM SenSys 2022 Best Demo Runner-up</a>
          <span class="profile-meta">(2022)</span>
        </li>
      </ul>
    </section>

    {%- comment -%} Experience {%- endcomment -%}
    <section id="experience" class="profile-section">
      <h2 class="profile-section__title">Experience</h2>
      <p class="career-group-label">Professional</p>
      <ul class="career-list">
        <li class="career-entry">
          <div class="career-identity">
            <img
              src="{{ '/assets/img/nvidia_logo_trimmed.png' | relative_url }}"
              alt="NVIDIA"
              class="career-logo career-logo--nvidia exp-logo-light"
            >
            <img
              src="{{ '/assets/img/nvidia_logo_wht_trimmed.png' | relative_url }}"
              alt=""
              aria-hidden="true"
              class="career-logo career-logo--nvidia exp-logo-dark"
            >
          </div>
          <div class="career-copy">
            <div class="career-heading">
              <span class="career-role">Software Engineer Intern</span>
              <span class="profile-meta">Summer 2026</span>
            </div>
            <div class="career-detail">NVIDIA · XR · Robotics and Physical AI</div>
          </div>
        </li>
      </ul>
      <p class="career-group-label">Education</p>
      <ul class="career-list">
        <li class="career-entry">
          <div class="career-identity">
            <img src="{{ '/assets/img/uw_signature.svg' | relative_url }}" alt="University of Washington" class="career-logo">
          </div>
          <div class="career-copy">
            <div class="career-heading">
              <span class="career-role">Ph.D. in Electrical and Computer Engineering</span>
              <span class="profile-meta">2023 &ndash; present</span>
            </div>
            <div class="career-detail">University of Washington · Advisor: <a href="https://www.akshaygadre.com/">Akshay Gadre</a> · <a href="https://newtlab.ece.uw.edu/">Networking and Emerging Wireless Technologies Lab (NEWT)</a></div>
          </div>
        </li>
        <li class="career-entry">
          <div class="career-identity">
            <img src="{{ '/assets/img/columbia_signature.svg' | relative_url }}" alt="Columbia University" class="career-logo">
          </div>
          <div class="career-copy">
            <div class="career-heading">
              <span class="career-role">M.S. in Electrical Engineering</span>
              <span class="profile-meta">2021 &ndash; 2023</span>
            </div>
            <div class="career-detail">Columbia University · Advisor: <a href="http://fredjiang.com/">Fred Jiang</a> · <a href="http://icsl.ee.columbia.edu/">Intelligent and Connected Systems Lab (ICSL)</a></div>
          </div>
        </li>
        <li class="career-entry">
          <div class="career-identity">
            <img src="/assets/img/scut_signature.png" alt="South China University of Technology" class="career-logo career-logo--scut">
          </div>
          <div class="career-copy">
            <div class="career-heading">
              <span class="career-role">B.E. in Automation Science and Engineering</span>
              <span class="profile-meta">2017 &ndash; 2021</span>
            </div>
            <div class="career-detail">South China University of Technology</div>
          </div>
        </li>
      </ul>
    </section>

    {%- comment -%} Services {%- endcomment -%}
    <section id="services" class="profile-section">
      <h2 class="profile-section__title">Services</h2>
      <ul class="profile-list">
        <li class="profile-list__item">Reviewer — ACM Transactions on Sensor Networks (TOSN)</li>
        <li class="profile-list__item">Reviewer — ACM Transactions on Computing for Healthcare (HEALTH)</li>
      </ul>
    </section>

    {%- comment -%} Teaching {%- endcomment -%}
    <section id="teaching" class="profile-section">
      <h2 class="profile-section__title">Teaching</h2>
      <ul class="profile-list">
        <li class="profile-list__item">
          Teaching Assistant — UW EE 497/598 Engineering Entrepreneurial Capstone
          <span class="profile-meta">(2026)</span>
        </li>
        <li class="profile-list__item">
          Teaching Assistant — UW EE 419/565 Computer Communication Networks
          <span class="profile-meta">(Spring 2025)</span>
        </li>
        <li class="profile-list__item">
          Teaching Assistant — UW EE 417/506 Modern Wireless Communications
          <span class="profile-meta">(Winter 2025)</span>
        </li>
        <li class="profile-list__item">
          Teaching Assistant — UW EE 215 Fundamentals of Electrical Engineering
          <span class="profile-meta">(Winter 2024)</span>
        </li>
      </ul>
    </section>
  </article>
</div>
