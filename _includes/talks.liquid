<ul class="profile-list talks-list">
  {% for talk in site.data.talks %}
    <li class="profile-list__item">
      {{ talk.title }}
      <span class="profile-meta"
        >({{ talk.venue -}}
        {%- if talk.year %}, {{ talk.year }}{% endif %})</span
      >
      {% if talk.video or talk.slides %}
        <span class="profile-meta" aria-hidden="true">—</span>
        {% if talk.video %}
          <a href="{{ talk.video }}">Video</a>
        {% endif %}
        {% if talk.video and talk.slides %}
          <span class="profile-meta" aria-hidden="true">·</span>
        {% endif %}
        {% if talk.slides %}
          <a href="{{ talk.slides }}">Slides</a>
        {% endif %}
      {% endif %}
    </li>
  {% endfor %}
</ul>
